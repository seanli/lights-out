{
  "name": "lights-out",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/to-artifact.mjs",
    "build:pwa": "vite build --mode pwa && node scripts/pwa-finish.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe.mjs",
    "look": "node scripts/look.mjs",
    "arch": "node scripts/gen-architecture.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run probe"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "valibot": "^1.5.0"
  }
}
